    if err:
        failures.append(err)
    digest = sha(path)
    source_hash_parts.append(f"{path}:{digest}")
    vault_manifest.append(f"{label} sha256={digest or 'UNAVAILABLE'} path={path}")

vault_sections = [section(
    "SHARED VAULT MANIFEST — verified at startup; task-scoped bodies remain on demand",
    "\n".join(vault_manifest),
)]

# VAULT-INDEX is the shared canonical index for both Claude and Erika. It is a
# startup authority surface, not task-scoped company data, so load its live body
# deterministically before COMPLETE.
vault_index_path = API_VAULT / "VAULT-INDEX.md"
