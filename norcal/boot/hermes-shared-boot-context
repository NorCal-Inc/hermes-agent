if vault_index_err:
    failures.append(vault_index_err)
    vault_index_body = f"BOOT REQUIRED FILE UNAVAILABLE: {vault_index_err}"
vault_sections.append(section("SHARED CANONICAL VAULT-INDEX — deterministically loaded", vault_index_body or ""))

# Today's daily log: index only unless a task requires deeper retrieval.
daily = VAULT / "Logs/daily" / f"{today}.md"
