    if daily_err:
        failures.append(daily_err)
        daily_view = f"BOOT REQUIRED FILE UNAVAILABLE: {daily_err}"
    else:
        lines = (daily_body or "").splitlines()
        daily_view = "\n".join(lines[:DAILY_INDEX_LINES])
        if len(lines) > DAILY_INDEX_LINES:
            daily_view += f"\n... [index window only; {len(lines)-DAILY_INDEX_LINES} more lines at {daily}] ..."
source_hash_parts.append(f"{daily}:{sha(daily)}")
vault_sections.append(section(f"today's daily log index: {daily.name}", daily_view))

# Latest checkpoint metadata for continuity.
# IMPORTANT: do not inject arbitrary checkpoint body text into shared boot. A checkpoint may
# contain company-private or task-scoped context. Shared boot may compare path/hash/mtime only;
# the checkpoint body is opened later only after task scope is known and authorized.
checkpoints = sorted(glob.glob(str(VAULT / "Logs/daily/*checkpoint*.md")), key=os.path.getmtime)
if checkpoints:
    cp = Path(checkpoints[-1])
    source_hash_parts.append(f"{cp}:{sha(cp)}")
    cp_meta = (
        f"LATEST CHECKPOINT METADATA ONLY\n"
        f"path={cp}\n"
        f"sha256={sha(cp)}\n"
        f"mtime={dt.datetime.fromtimestamp(cp.stat().st_mtime, tz=now.tzinfo).isoformat()}\n"
        "body_not_loaded=true — open only after the current task scope authorizes it"
    )
    vault_sections.append(section(f"latest checkpoint metadata: {cp.name}", cp_meta))
else:
    failures.append("no checkpoint file found")

# Live local repo state. No network fetch, no credentials, no company-private reads.
