    failures.append(constraints_err or f"{BOOT_CONSTRAINTS}: empty canonical boot constraints")
    constraints_body = "# NORTH CALEDONIA SHARED BOOT CONSTRAINTS\n\nBOOT CONSTRAINTS UNAVAILABLE — STOP BEFORE TASK EXECUTION."
else:
    constraints_body = constraints_body.strip()
    source_hash_parts.append(f"{BOOT_CONSTRAINTS}:{sha(BOOT_CONSTRAINTS)}")
for name in doctrine_files:
    p = DOCTRINE / name
    body, err = read_text(p)
    if err:
        failures.append(err)
        body = f"BOOT REQUIRED FILE UNAVAILABLE: {err}"
    digest = sha(p)
    source_hash_parts.append(f"{p}:{digest}")
    flags = []
    if name in unranked:
        flags.append("UNRANKED-BUT-BINDING")
    flag_text = f" flags={','.join(flags)}" if flags else ""
    doctrine_manifest.append(f"{name} sha256={digest or 'UNAVAILABLE'} path={p}{flag_text}")
    doctrine_loaded_sections.append(section(f"BINDING DOCTRINE: {name}", body or ""))

doctrine_sections = [
    section("DOCTRINE MANIFEST — deterministically loaded and verified below", "\n".join(doctrine_manifest)),
    *doctrine_loaded_sections,
]

# Shared vault session-start chain. Deliberately excludes company-private folders.
