if checkpoints:
    checkpoint_ts = dt.datetime.fromtimestamp(Path(checkpoints[-1]).stat().st_mtime, tz=now.tzinfo)
else:
    checkpoint_ts = None

if newest_session_ts and checkpoint_ts:
    checkpoint_freshness = (
        f"FRESH — checkpoint mtime {checkpoint_ts.isoformat()} >= newest Claude session mtime {newest_session_ts.isoformat()}"
        if checkpoint_ts >= newest_session_ts
        else f"STALE — newest Claude session mtime {newest_session_ts.isoformat()} is newer than checkpoint mtime {checkpoint_ts.isoformat()}; treat carry-forward state as unverified"
    )
elif newest_session_ts and not checkpoint_ts:
    checkpoint_freshness = "STALE — Claude session history exists but no checkpoint was found"
else:
    checkpoint_freshness = "UNVERIFIED — no Claude session metadata available for comparison"

# Open-item reconciliation is intentionally on-demand. It is not a boot safety
# gate and historically costs several seconds even when returning nonzero.
# Current-task continuity comes from canonical Kanban state; run the full
# checker only when a request actually depends on broader open-item truth.
open_items = (
    "ON-DEMAND — not executed during thin boot. "
    "Run /home/chris/.local/bin/open-items-check only when the current request "
    "requires broader open-item reconciliation."
)

# Compact canonical open-priorities manifest. This is intentionally NOT the
# full Active Priorities body: it gives Erika enough continuity to resolve
# named work that is not currently represented by an active Kanban card, while
# preserving the memory-on-demand/token discipline. Each OPEN section contributes
# its heading plus the first non-empty content line only.
active_priorities_path = VAULT / "Active Priorities.md"
active_priorities_body, active_priorities_err = read_text(active_priorities_path)
if active_priorities_err:
    failures.append(active_priorities_err)
    open_priorities_manifest = f"UNAVAILABLE — {active_priorities_err}"
else:
    ap_lines = (active_priorities_body or "").splitlines()
    ap_rows = []
    i = 0
    while i < len(ap_lines):
        line = ap_lines[i].strip()
        if line.startswith("## OPEN "):
            summary = ""
            j = i + 1
            while j < len(ap_lines):
                candidate = ap_lines[j].strip()
                if candidate.startswith("## "):
                    break
                if candidate and not candidate.startswith("<!--"):
                    summary = candidate
                    break
                j += 1
            ap_rows.append(f"- {line[3:]}" + (f" — {summary}" if summary else ""))
        i += 1
    open_priorities_manifest = "\n".join(ap_rows) if ap_rows else "(none)"

kanban_continuity, kanban_err = kanban_continuity_state()
if kanban_err:
    failures.append(f"kanban continuity unavailable: {kanban_err}")

# External skill/plugin supply-chain gate. Cleared third-party copies are pinned by content
# hash and frozen locally. Any drift or unregistered externally installed skill/plugin makes
# shared boot DEGRADED before an agent is allowed to execute work.
skill_trust, st_rc = run([str(HERMES / "security/skill-trust/verify.py")], timeout=20)
if st_rc != 0:
    failures.append(f"skill supply-chain gate failed rc={st_rc}: {skill_trust or 'no verifier output'}")
    skill_trust = skill_trust or "SKILL TRUST: FAIL — verifier returned no output"

skill_integrity_raw, si_rc = run(
    [str(CH / ".local/bin/skill-integrity"), "verify", "--json"], timeout=30
)
try:
    si = __import__("json").loads(skill_integrity_raw or "{}")
    violations = si.get("violations") or []
    missing = si.get("missing") or []
    unfrozen_all = si.get("unfrozen") or []
    # Claude marketplace *.staging trees are source/download staging, not active
    # installed payloads. Active installed plugins remain covered by the separate
    # claude-cache root. Do not degrade boot solely for staged marketplace copies.
    staging_unfrozen = [x for x in unfrozen_all if ".staging/" in x]
    active_unfrozen = [x for x in unfrozen_all if ".staging/" not in x]
    integrity_clean = not (violations or missing or active_unfrozen)
    skill_integrity = (
        f"SKILL INTEGRITY: {'OK' if integrity_clean else 'FAIL'} — "
        f"frozen={si.get('locked', 0)} changed={len(violations)} "
        f"active_unfrozen={len(active_unfrozen)} missing={len(missing)} "
        f"staging_ignored={len(staging_unfrozen)}"
    )
    if not integrity_clean:
        failures.append(
            "full skill integrity gate failed: "
            f"changed={len(violations)} active_unfrozen={len(active_unfrozen)} missing={len(missing)}"
        )
except Exception as exc:
    skill_integrity = skill_integrity_raw or "SKILL INTEGRITY: FAIL — verifier returned no output"
    if si_rc != 0:
        failures.append(f"full skill integrity gate failed rc={si_rc}: {type(exc).__name__}: {exc}")

# Runtime identity without reading secrets.
def pyproject_version(root: Path) -> str:
    p = root / "pyproject.toml"
    body, err = read_text(p)
    if err or not body:
        return "UNAVAILABLE"
    m = re.search(r'(?m)^version\s*=\s*"([^"]+)"', body)
    return m.group(1) if m else "UNAVAILABLE"

target_v = pyproject_version(HERMES / "hermes-agent-next")

fingerprint = hashlib.sha256("\n".join(source_hash_parts).encode()).hexdigest()
