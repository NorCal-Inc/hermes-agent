BOOT TIME: {now.isoformat()}
BOOT SOURCE FINGERPRINT: {fingerprint}
DOCTRINE VERSION: {version_of(readme)}
DOCTRINE REPO HEAD: {doctrine_head or 'UNAVAILABLE'}
VAULT REPO HEAD: {vault_head or 'UNAVAILABLE'}
HERMES RUNTIME VERSION: target={target_v}
