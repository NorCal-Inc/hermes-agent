    ("Identity/Goals.md", VAULT / "Identity/Goals.md", None),
    ("Identity/Rules.md", VAULT / "Identity/Rules.md", None),
    ("Jobs/mistake-logging.md", VAULT / "Jobs/mistake-logging.md", None),
    ("Active Priorities.md", VAULT / "Active Priorities.md", None),
]

vault_manifest = []
for label, path, _ in required_vault:
