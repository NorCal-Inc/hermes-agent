def read_text(path: Path):
    try:
        return path.read_text(encoding="utf-8"), None
    except Exception as exc:
        return None, f"{path}: {exc}"


def run(argv, timeout=20):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        body = (p.stdout or p.stderr or "").strip()
        return body, p.returncode
    except Exception as exc:
        return f"(failed: {exc})", 255


def section(title: str, body: str) -> str:
    return f"===== {title} =====\n{body}"


def sha(path: Path) -> str:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except Exception:
        return "UNAVAILABLE"


def version_of(path: Path) -> str:
    text, err = read_text(path)
    if err:
        return "UNAVAILABLE"
    m = re.search(r"(?m)^Version:\s*(.+)$", text or "")
    return m.group(1).strip() if m else "UNVERSIONED"


def _epoch_iso(value) -> str:
    if value in (None, ""):
        return "-"
    try:
        return dt.datetime.fromtimestamp(float(value), tz=now.tzinfo).isoformat()
    except Exception:
        return str(value)


def kanban_continuity_state() -> tuple[str, str | None]:
    """Return bounded shared-system Kanban continuity without task bodies.

    Boot must answer "what is currently in flight?" from the canonical task
    database, not from model memory, old checkpoints, tmux panes, or Codex
    session history. Company-scoped task bodies/titles are intentionally not
    loaded here. Only shared-system assignees are eligible.
    """
    if not KANBAN_DB.exists():
        return "KANBAN CONTINUITY: UNAVAILABLE — canonical kanban.db is missing", str(KANBAN_DB)

    try:
        con = sqlite3.connect(f"file:{KANBAN_DB}?mode=ro", uri=True, timeout=5)
        con.row_factory = sqlite3.Row
        cutoff = int(now.timestamp()) - KANBAN_RECENT_SECONDS
        terminal_cutoff = int(now.timestamp()) - KANBAN_RECENT_TERMINAL_SECONDS
        placeholders = ",".join("?" for _ in KANBAN_SHARED_ASSIGNEES)
        params = tuple(sorted(KANBAN_SHARED_ASSIGNEES))

        seed_rows = con.execute(
            f"""
            SELECT id,title,assignee,status,priority,created_at,started_at,
                   completed_at,current_run_id,last_heartbeat_at,last_failure_error
              FROM tasks
             WHERE assignee IN ({placeholders})
               AND (
                    status='running'
                    OR (status IN ('ready','todo','review','blocked') AND
                        COALESCE(last_heartbeat_at,started_at,created_at,0) >= ?)
                    OR (status='done' AND
                        COALESCE(completed_at,last_heartbeat_at,started_at,created_at,0) >= ?)
               )
             ORDER BY CASE status WHEN 'running' THEN 0 WHEN 'review' THEN 1
                                  WHEN 'ready' THEN 2 WHEN 'todo' THEN 3 ELSE 4 END,
                      COALESCE(last_heartbeat_at,started_at,created_at,0) DESC
             LIMIT 20
            """,
            params + (cutoff, terminal_cutoff),
        ).fetchall()

        task_ids = {r["id"] for r in seed_rows}
        frontier = set(task_ids)
        # Pull one-hop parents/children, then a second hop. This preserves a
        # completed orchestration parent and its pending verification child.
        for _ in range(2):
            if not frontier:
                break
            marks = ",".join("?" for _ in frontier)
            links = con.execute(
                f"SELECT parent_id,child_id FROM task_links "
                f"WHERE parent_id IN ({marks}) OR child_id IN ({marks})",
                tuple(frontier) + tuple(frontier),
            ).fetchall()
            discovered = set()
            for link in links:
                discovered.add(link["parent_id"])
                discovered.add(link["child_id"])
            frontier = discovered - task_ids
            task_ids |= discovered

        if not task_ids:
            con.close()
            return "KANBAN CONTINUITY: no recent shared-system active tasks", None

        marks = ",".join("?" for _ in task_ids)
        rows = con.execute(
            f"""
            SELECT id,title,assignee,status,priority,created_at,started_at,
                   completed_at,current_run_id,last_heartbeat_at,last_failure_error
              FROM tasks
             WHERE id IN ({marks}) AND assignee IN ({placeholders})
            """,
            tuple(task_ids) + params,
        ).fetchall()
        by_id = {r["id"]: r for r in rows}
        latest_runs = {}
        for tid in by_id:
            rr = con.execute(
                "SELECT id,status,outcome,summary,error,started_at,ended_at "
                "FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1",
                (tid,),
            ).fetchone()
            if rr:
                latest_runs[tid] = rr

        links = con.execute(
            f"SELECT parent_id,child_id FROM task_links "
            f"WHERE parent_id IN ({marks}) OR child_id IN ({marks})",
            tuple(task_ids) + tuple(task_ids),
        ).fetchall()
        con.close()

        lines = [
            "KANBAN CONTINUITY: canonical live task state",
            f"source={KANBAN_DB}",
            "rule=use this before recall/checkpoints/Codex-session forensics when asked for current task status",
        ]

        # Executive attention summary: make the governing interpretation
        # explicit so a thin front-door agent does not have to infer it from a
        # flat task dump or fall back to historical recall. A terminal task
        # whose verifier summary says FAIL is completed as a phase, not accepted
        # as an overall objective.
        attention = []
        for r in by_id.values():
            rr = latest_runs.get(r["id"])
            summary = ((rr["summary"] if rr else None) or "").strip().replace("\n", " ")
            error = ((rr["error"] if rr else None) or r["last_failure_error"] or "").strip().replace("\n", " ")
            fail_verdict = bool(re.match(r"\s*(FAIL|NO[- ]GO)\b", summary, re.I))
            if r["status"] == "running":
                rank = 0
                reason = "RUNNING"
            elif fail_verdict:
                rank = 1
                reason = "FAILED_VERIFICATION — phase may be done; objective is not accepted"
            elif r["status"] in {"blocked", "review", "ready", "todo"}:
                rank = 2
                reason = f"UNRESOLVED_{str(r['status']).upper()}"
            elif error:
                rank = 3
                reason = "TERMINAL_WITH_ERROR"
            else:
                continue
            ts = r["last_heartbeat_at"] or r["completed_at"] or r["started_at"] or r["created_at"] or 0
            attention.append((rank, -ts, r, reason, summary, error))
        attention.sort(key=lambda x: (x[0], x[1]))
        if attention:
            _, _, primary, primary_reason, primary_summary, primary_error = attention[0]
            lines.append(
                "PRIMARY CURRENT TASK — use this first for generic current-task/status questions; "
                "do not substitute older unresolved work unless the user names it:"
            )
            lines.append(
                f"  {primary['id']} | {primary_reason} | title={primary['title']}"
            )
            detail = primary_summary or primary_error
            if detail:
                if len(detail) > 360:
                    detail = detail[:357] + "..."
                lines.append(f"    detail={detail}")
            if len(attention) > 1:
                lines.append("SECONDARY ATTENTION — report only if relevant to the user's request:")
                for _, _, r, reason, summary, error in attention[1:3]:
                    lines.append(f"  {r['id']} | {reason} | title={r['title']}")
        else:
            lines.append("PRIMARY CURRENT TASK: no running/unresolved/failed-verification shared-system task in this window")

        ordered = sorted(
            by_id.values(),
            key=lambda r: (
                0 if r["status"] == "running" else 1,
                -(r["last_heartbeat_at"] or r["started_at"] or r["created_at"] or 0),
            ),
        )
        for r in ordered:
            failure = (r["last_failure_error"] or "").strip().replace("\n", " ")
            if len(failure) > 180:
                failure = failure[:177] + "..."
            lines.append(
                f"TASK {r['id']} | {r['status']} | assignee={r['assignee']} | "
                f"run={r['current_run_id'] or '-'} | heartbeat={_epoch_iso(r['last_heartbeat_at'])} | "
                f"title={r['title']}"
            )
            if failure:
                lines.append(f"  last_failure={failure}")
            rr = latest_runs.get(r["id"])
            if rr:
                summary = (rr["summary"] or "").strip().replace("\n", " ")
                if len(summary) > 420:
                    summary = summary[:417] + "..."
                if rr["outcome"] or summary or rr["error"]:
                    lines.append(
                        f"  latest_run=id:{rr['id']} status:{rr['status'] or '-'} "
                        f"outcome:{rr['outcome'] or '-'} ended:{_epoch_iso(rr['ended_at'])}"
                    )
                if summary:
                    lines.append(f"  latest_summary={summary}")
                if rr["error"]:
                    err = str(rr["error"]).strip().replace("\n", " ")
                    if len(err) > 220:
                        err = err[:217] + "..."
                    lines.append(f"  latest_error={err}")
        if links:
            lines.append("TASK GRAPH:")
            seen_links = set()
            for link in links:
                pair = (link["parent_id"], link["child_id"])
                if pair in seen_links or pair[0] not in by_id or pair[1] not in by_id:
                    continue
                seen_links.add(pair)
                lines.append(f"  {pair[0]} -> {pair[1]}")
        return "\n".join(lines), None
    except Exception as exc:
        return f"KANBAN CONTINUITY: UNAVAILABLE — {type(exc).__name__}: {exc}", str(exc)


def precedence_order() -> list[str]:
    text, err = read_text(DOCTRINE / "doctrine_precedence.md")
    if err or not text:
        return []
    out = []
    in_order = False
    for line in text.splitlines():
        if line.strip() == "## Precedence order":
            in_order = True
            continue
        if in_order and line.startswith("## "):
            break
        m = re.match(r"^\d+\.\s+([A-Za-z0-9_.-]+\.md)\b", line.strip())
        if m:
            out.append(m.group(1))
    return out


now = dt.datetime.now().astimezone()
today = now.date().isoformat()
failures: list[str] = []

readme = DOCTRINE / "README.md"
