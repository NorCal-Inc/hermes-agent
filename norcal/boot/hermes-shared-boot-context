# Deterministic Gauntlet startup invariant. Startup must load and verify every
# binding doctrine file before BOOT STATUS may become COMPLETE. The model must
# receive the same live bodies in precedence order; a manifest plus an
# instruction to fetch later is not sufficient authority. Hashes remain in the
# manifest so the exact loaded corpus is auditable.
doctrine_files = ["README.md", "doctrine_precedence.md"] + ordered + unranked
