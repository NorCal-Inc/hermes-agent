{
  "name": "@hermes/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes Mobile — PWA home selector, Hermes picker, and messaging-style chat.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@hermes/shared": "file:../shared",
    "clsx": "2.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
